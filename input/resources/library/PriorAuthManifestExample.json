  "description": "Example CRMI version manifest and dependency declaration for the prior-authorization example questionnaires defined in this implementation guide. It declares the exact versions of the US Core implementation guide, CQL libraries, value sets, terminology (code systems), and ConceptMap/map packages that the example questionnaires depend on, along with the publisher, stewardship model, and update cadence for those dependencies. It is intended as a template that downstream implementation guides can adapt to declare their own dependency versions.",
  "jurisdiction": [
    {
      "coding": [
        {
          "system": "urn:iso:std:iso:3166",
          "code": "US",
          "display": "United States of America"
        }
      ]
    }
  ],
  "purpose": "Provide a single, machine-readable declaration of the specific dependency versions used to author, test, and evaluate the prior-authorization example questionnaires, so that consumers can reproduce identical evaluation behavior.",
  "usage": "Use the pinned dependency versions in this manifest when packaging or evaluating the prior-authorization example questionnaires to ensure reproducible results. When adapting for a downstream deployment, update each pinned version to the version approved for that deployment.",
  "approvalDate": "2026-07-26",
  "lastReviewDate": "2026-07-26",
  "effectivePeriod": {
